# Normaliza fim de linha: LF no repositorio, nativo na maquina de quem clona
* text=auto eol=lf

*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
Procfile text eol=lf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.svg text eol=lf
*.ico binary
*.sqlite3 binary
