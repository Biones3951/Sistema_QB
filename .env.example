# ---- Django ----
DEBUG=False
SECRET_KEY=troque-por-uma-chave-secreta-longa
# Dominio do backend (sem https://), separado por virgula
ALLOWED_HOSTS=sistema-qb.onrender.com

# ---- Banco de dados: Supabase ----
# Supabase > Project Settings > Database > Connection string > URI
# Use o "Session pooler" (porta 5432). Troque [YOUR-PASSWORD] pela senha do banco.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DB_SSLMODE=require
CONN_MAX_AGE=0
# Marque True apenas se usar o "Transaction pooler" (porta 6543)
DISABLE_SERVER_SIDE_CURSORS=False

# ---- Frontend autorizado (CORS) ----
CORS_ALLOWED_ORIGINS=https://sistema-qb.vercel.app
CSRF_TRUSTED_ORIGINS=https://sistema-qb.vercel.app,https://sistema-qb.onrender.com

# ---- Local (desenvolvimento) ----
# Deixe DATABASE_URL vazio e USE_SQLITE=True para rodar com SQLite
USE_SQLITE=True
